@@ -26,3 +26,15 @@ func (s *Store) Find(ctx context.Context, id string) (*Invoice, error) {
 	}
 	return &inv, nil
 }
+
+// FindForOwner loads one invoice by id only when ownerID owns it.
+func (s *Store) FindForOwner(ctx context.Context, id, ownerID string) (*Invoice, error) {
+	var inv Invoice
+	err := s.DB.QueryRowContext(ctx,
+		"SELECT id, owner_id, pdf FROM invoices WHERE id = $1 AND owner_id = $2", id, ownerID,
+	).Scan(&inv.ID, &inv.OwnerID, &inv.PDF)
+	if err != nil {
+		return nil, err
+	}
+	return &inv, nil
+}
