@@ -9,6 +9,11 @@ export async function chargeInvoice(
   customerId: string,
   amountCents: number,
 ): Promise<ChargeResult> {
-  const charge = await gateway.charge(customerId, amountCents);
-  return { ok: true, chargeId: charge.id };
+  try {
+    const charge = await gateway.charge(customerId, amountCents);
